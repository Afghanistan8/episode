# Where the app looks for Episode.
#
# Studionet is the default: chain 61999 on the Studio endpoint, which is what
# genlayer-js itself calls studionet. The chain id is signed over, so it has to
# match the network you are actually talking to.
#
# The two alternates:
#   61997 https://studio.genlayer.com/api          (Studio)
#   61998 https://studio-next.genlayer.com/api     (Studio Next)
NEXT_PUBLIC_EPISODE_CHAIN_ID=61999
NEXT_PUBLIC_EPISODE_RPC=https://studio.genlayer.com/api
NEXT_PUBLIC_EPISODE_CONTRACT=0x0000000000000000000000000000000000000000

# Fixture mode. Off by default, and never on in the deployed app: with it on
# the app reads a file held in memory instead of the chain, which is useful
# for working on the pages and useless for anything else.
NEXT_PUBLIC_EPISODE_FIXTURES=0
