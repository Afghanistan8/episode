# Where the app looks for Episode.
#
# Studionet is the default. The chain id is signed over, so it has to be the
# one the network actually uses -- these are the SDK's own pairs, and 61997 is
# Devnet on its own host rather than another id for Studio:
#
#   61999  https://studio.genlayer.com/api       studionet
#   61997  https://studio-dev.genlayer.com/api   studioDevnet
#   61127  http://127.0.0.1:4000/api             localnet
#
# Leave the RPC unset to take the endpoint the SDK pairs with the id.
NEXT_PUBLIC_EPISODE_CHAIN_ID=61999
# Verified on Studionet; see .episode-deploy.json in the repository root.
NEXT_PUBLIC_EPISODE_CONTRACT=0x9e6985b530A0c422E876C773b2d8b4e58E20b4f5

# Fixture mode. Off by default, and never on in the deployed app: with it on
# the app reads a file held in memory instead of the chain, which is useful
# for working on the pages and useless for anything else.
NEXT_PUBLIC_EPISODE_FIXTURES=0
